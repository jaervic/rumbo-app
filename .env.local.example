# Variables de entorno de ejemplo
# Copia este archivo a .env.local y completa los valores.
# .env.local NO se versiona (ver .gitignore).

# --- Supabase (Fase 1: auth por enlace mágico) -------------------------------
# Project Settings -> API en el panel de Supabase.
# La anon key es PÚBLICA por diseño (RLS protege los datos); NUNCA pongas aquí la service_role.
# Si se dejan vacías, la app funciona igual: el cotizador no depende de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (para metadatos Open Graph/Twitter y canonical).
# En Vercel: el dominio final, p. ej. https://rumbo.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- APIs públicas (no requieren clave ni configuración) ---------------------
# Autocompletado de direcciones: Photon (https://photon.komoot.io)
# Rutas: OSRM (https://router.project-osrm.org)
# Tiles del mapa: OpenStreetMap
